<sitemesh>
    <!-- Loại trừ Servlet đọc ảnh -->
    <mapping path="/image*" exclude="true" />

    <!-- Decorator cho Admin -->
    <mapping path="/admin/*" decorator="/WEB-INF/decorators/admin.jsp" />

    <!-- Ánh xạ các trang người dùng thông thường qua layout web.jsp -->
    <mapping path="/*" decorator="/WEB-INF/decorators/web.jsp" />
</sitemesh>